<Window x:Class="Casium.Dialogs.McpServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:core="clr-namespace:Casium.Core;assembly=Casium.Core"
        Title="MCP server"
        Width="580" Height="664"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Bg.Base}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Primary}"
        UseLayoutRounding="True"
        WindowStyle="None">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Window.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="MCP server"
                               Style="{StaticResource Txt.H2}"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                    <Button Content="&#xE8BB;"
                            Style="{StaticResource Btn.WindowClose}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            HorizontalAlignment="Right"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- body -->
            <Grid Grid.Row="1" Margin="24,18,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">

                        <TextBlock Text="Start from a preset" Style="{StaticResource Txt.Caption}"/>
                        <ComboBox x:Name="PresetCombo" Margin="0,6,0,16"
                                  SelectionChanged="PresetCombo_SelectionChanged"/>

                        <TextBlock Text="Name" Style="{StaticResource Txt.Caption}"/>
                        <TextBox x:Name="NameBox" Margin="0,6,0,14"
                                 Tag="Shown in the sidebar and in tool calls"/>

                        <TextBlock Text="Command" Style="{StaticResource Txt.Caption}"/>
                        <TextBox x:Name="CommandBox" Margin="0,6,0,14"
                                 FontFamily="{StaticResource Font.Mono}"
                                 Tag="npx, docker, uvx, or a path to an executable"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Arguments" Style="{StaticResource Txt.Caption}"/>
                            <Button x:Name="FolderButton"
                                    Grid.Row="0" Grid.Column="1"
                                    Style="{StaticResource Btn.Ghost}" Padding="8,2"
                                    Click="BrowseFolder_Click"
                                    ToolTip="Pick a folder (e.g. your Visual Studio solution) and append its path to the arguments">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Font.Icons}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Folder…" FontSize="11.5" VerticalAlignment="Center"
                                               Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="ArgsBox" Margin="0,6,0,0"
                                     FontFamily="{StaticResource Font.Mono}"
                                     Tag="-y @modelcontextprotocol/server-filesystem C:\path\to\project"/>
                        </Grid>

                        <TextBlock Text="Environment variables (one KEY=value per line)" Style="{StaticResource Txt.Caption}"/>
                        <TextBox x:Name="EnvBox" Margin="0,6,0,14"
                                 MinHeight="84" MaxHeight="160"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource Font.Mono}"
                                 Tag="GITHUB_PERSONAL_ACCESS_TOKEN=ghp_…"/>

                        <TextBlock Text="Servers run as local child processes — nothing is sent to any cloud."
                                   Style="{StaticResource Txt.Muted}" TextWrapping="Wrap"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- footer -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource Btn.Ghost}" Click="Cancel_Click">
                            <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    <Button Style="{StaticResource Btn.Primary}" HorizontalAlignment="Right"
                            Click="Save_Click" MinWidth="130">
                        <TextBlock Text="Save server" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
