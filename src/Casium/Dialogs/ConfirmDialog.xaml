<Window x:Class="Casium.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Confirm"
        Width="440" SizeToContent="Height" MaxHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Bg.Base}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Primary}"
        UseLayoutRounding="True"
        WindowStyle="None">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Window.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="Confirm"
                               Style="{StaticResource Txt.H2}"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                    <Button Content="&#xE8BB;"
                            Style="{StaticResource Btn.WindowClose}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            HorizontalAlignment="Right"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,16,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="MessageText"
                           Grid.Row="0"
                           Style="{StaticResource Txt.BodySecondary}"
                           TextWrapping="Wrap"/>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left"
                            Click="Cancel_Click">
                        <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ConfirmButton" Style="{StaticResource Btn.Primary}"
                            HorizontalAlignment="Right" MinWidth="110"
                            Click="Confirm_Click">
                        <TextBlock Text="Confirm" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
