<UserControl x:Class="Casium.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chat="clr-namespace:Casium.Chat"
             xmlns:controls="clr-namespace:Casium.Controls"
             xmlns:md="clr-namespace:Casium.Core;assembly=Casium.Core">

    <UserControl.Resources>

        <!-- ============================== user message ============================== -->

        <DataTemplate DataType="{x:Type chat:UserChatItem}">
            <Grid Margin="0,12,0,0">
                <StackPanel HorizontalAlignment="Right" MaxWidth="680">
                    <Border Background="{DynamicResource Brush.UserBubble.Bg}"
                            BorderBrush="{DynamicResource Brush.UserBubble.Border}"
                            BorderThickness="1"
                            CornerRadius="14,14,4,14"
                            Padding="13,9">
                        <TextBlock Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   FontSize="13.5" LineHeight="21"
                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                    </Border>
                    <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm}'}"
                               Style="{StaticResource Txt.Muted}"
                               HorizontalAlignment="Right"
                               Margin="4,5,4,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ============================== assistant message ============================== -->

        <DataTemplate DataType="{x:Type chat:AssistantChatItem}">
            <Grid Margin="0,12,0,0">
                <StackPanel Margin="0,0,72,0">
                    <Grid Margin="0,0,0,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7"
                                     Fill="{DynamicResource Brush.Accent}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Model}"
                                       Style="{StaticResource Txt.Caption}"/>
                            <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm}'}"
                                       Style="{StaticResource Txt.Muted}"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding Streaming, Converter={StaticResource Conv.Not}}">
                            <Button Style="{StaticResource Btn.Icon}"
                                    ToolTip="Copy message"
                                    FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                    Content="&#xE8C8;"
                                    Click="CopyMessage_Click"/>
                            <Button Style="{StaticResource Btn.Icon}"
                                    ToolTip="Regenerate"
                                    FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                    Content="&#xE72C;"
                                    Click="Regenerate_Click"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Blocks}">
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type md:MdSegment}">
                                <controls:MarkdownTextBlock Text="{Binding Text}"/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type md:MdCode}">
                                <Border Background="{DynamicResource Brush.Code.Bg}"
                                        BorderBrush="{DynamicResource Brush.Code.Border}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,4,0,8"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Background="{DynamicResource Brush.Bg.Sunken}"
                                                BorderBrush="{DynamicResource Brush.Code.Border}"
                                                BorderThickness="0,0,0,1"
                                                CornerRadius="10,10,0,0"
                                                Padding="12,6">
                                            <Grid>
                                                <TextBlock Text="{Binding Lang}"
                                                           FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                                           VerticalAlignment="Center"/>
                                                <Button HorizontalAlignment="Right"
                                                        Style="{StaticResource Btn.Ghost}"
                                                        Padding="6,2"
                                                        Click="CopyCode_Click"
                                                        ToolTip="Copy code">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8C8;"
                                                                   FontFamily="{StaticResource Font.Icons}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="Copy"
                                                                   FontSize="11.5"
                                                                   VerticalAlignment="Center"
                                                                   Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <ScrollViewer Grid.Row="1"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto"
                                                      MaxHeight="420"
                                                      Padding="12,10">
                                            <TextBlock Text="{Binding Code}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="12.5"
                                                       HorizontalAlignment="Left"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>

                    <TextBlock Text="&#x258D;"
                               FontSize="14"
                               Foreground="{DynamicResource Brush.Accent}"
                               Visibility="{Binding Streaming, Converter={StaticResource Conv.Bool}}">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.15"
                                                         Duration="0:0:0.65" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>

                    <TextBlock Text="{Binding Stats}"
                               Style="{StaticResource Txt.Muted}"
                               Margin="0,6,0,0"
                               Visibility="{Binding Streaming, Converter={StaticResource Conv.Not}}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ============================== tool use card ============================== -->

        <DataTemplate DataType="{x:Type chat:ToolChatItem}">
            <Border Background="{DynamicResource Brush.ToolUse.Bg}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10"
                    Margin="0,4,96,4"
                    Width="620"
                    HorizontalAlignment="Left">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE756;"
                                       FontFamily="{StaticResource Font.Icons}"
                                       FontSize="13"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,0"/>
                            <TextBlock Text="{Binding Title}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <controls:Pill Text="{Binding StatusText}"
                                       Kind="{Binding StatusKind}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                    </Grid>

                    <Expander Header="Arguments" FontSize="12"
                              Margin="0,8,0,0"
                              Visibility="{Binding HasArgs, Converter={StaticResource Conv.Bool}}">
                        <Border Background="{DynamicResource Brush.Code.Bg}"
                                BorderBrush="{DynamicResource Brush.Code.Border}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="10" MaxHeight="200"
                                Margin="0,4,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding ArgsJson}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            </ScrollViewer>
                        </Border>
                    </Expander>

                    <Expander Header="Result" FontSize="12" IsExpanded="False" Margin="0,4,0,0">
                        <Border Background="{DynamicResource Brush.Code.Bg}"
                                BorderBrush="{DynamicResource Brush.Code.Border}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="10" MaxHeight="280"
                                Margin="0,4,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding ResultText}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            </ScrollViewer>
                        </Border>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ============================== notice ============================== -->

        <DataTemplate DataType="{x:Type chat:NoticeChatItem}">
            <Border Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    CornerRadius="999"
                    Padding="14,7"
                    Background="{DynamicResource Brush.Bg.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Icon" Text="&#xE946;"
                               FontFamily="{StaticResource Font.Icons}"
                               FontSize="12.5"
                               Foreground="{DynamicResource Brush.Info}"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0"/>
                    <TextBlock Text="{Binding Text}"
                               FontSize="12.5"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="560"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                    <Setter TargetName="Icon" Property="Text" Value="&#xE7BA;"/>
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter TargetName="Icon" Property="Text" Value="&#xE783;"/>
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ============================== layout ============================== -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,12,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Model" Style="{StaticResource Txt.Muted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ModelCombo" MinWidth="230"
                              SelectionChanged="ModelCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="{StaticResource Font.Mono}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayInfo}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               VerticalAlignment="Center"
                                               Margin="14,0,0,0"
                                               Grid.Column="1"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Button x:Name="RefreshButton" Grid.Column="1"
                        Style="{StaticResource Btn.Icon}"
                        FontFamily="{StaticResource Font.Icons}" FontSize="13"
                        Content="&#xE72C;"
                        ToolTip="Refresh models"
                        Click="RefreshModels_Click"
                        Margin="6,0,0,0"/>

                <Button x:Name="ToolsChip" Grid.Column="3"
                        Style="{StaticResource Btn.Ghost}"
                        Padding="10,6"
                        Margin="0,0,10,0"
                        Click="ToolsChip_Click"
                        ToolTip="MCP servers connected to this chat">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE756;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ToolsChipText" Text="MCP tools"
                                   FontSize="12" VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Prompt" Style="{StaticResource Txt.Muted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PromptCombo" MinWidth="190"
                              DisplayMemberPath="Name"
                              SelectionChanged="PromptCombo_SelectionChanged"/>
                </StackPanel>

                <Button Grid.Column="5"
                        Style="{StaticResource Btn.Secondary}"
                        Click="NewChat_Click"
                        ToolTip="Start a fresh conversation">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="New chat"
                                   FontSize="12.5" VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- messages -->

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="Scroller"
                          VerticalScrollBarVisibility="Auto"
                          ScrollChanged="Scroller_ScrollChanged">
                <ItemsControl x:Name="Messages" Margin="24,18,24,10"/>
            </ScrollViewer>

            <!-- empty state -->
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Image Source="/Assets/logo.png"
                       Width="56" Height="56"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"/>
                <TextBlock Text="Good to see you"
                           Style="{StaticResource Txt.H1}"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>
                <TextBlock Text="Ask anything. Your words never leave this machine."
                           Style="{StaticResource Txt.BodySecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>

                <WrapPanel x:Name="Suggestions"
                           Margin="0,22,0,0"
                           HorizontalAlignment="Center"
                           MaxWidth="640">
                    <ToggleButton Style="{StaticResource Chip}" Margin="0,0,8,8" Click="Suggestion_Click"
                                  Content="Explain what MCP servers do"/>
                    <ToggleButton Style="{StaticResource Chip}" Margin="0,0,8,8" Click="Suggestion_Click"
                                  Content="Write a C# helper that debounces an event"/>
                    <ToggleButton Style="{StaticResource Chip}" Margin="0,0,8,8" Click="Suggestion_Click"
                                  Content="Review this method for bugs"/>
                    <ToggleButton Style="{StaticResource Chip}" Margin="0,0,8,8" Click="Suggestion_Click"
                                  Content="Plan a weekend coding project"/>
                </WrapPanel>

                <Button x:Name="BrowseModelsButton"
                        Style="{StaticResource Btn.Primary}"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        Click="GoBrowse_Click"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE719;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Download a model"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- onboarding (engine offline) -->
            <Border x:Name="Onboarding"
                    Style="{StaticResource Card}"
                    Padding="30"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="{StaticResource Font.Icons}"
                               FontSize="30"
                               Foreground="{DynamicResource Brush.Accent}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Connect a local engine"
                               Style="{StaticResource Txt.H2}"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0"/>
                    <TextBlock Text="Casium runs models through Ollama — the free, open-source runtime that keeps everything on your hardware. Install it, then come back: Casium will detect it automatically."
                               Style="{StaticResource Txt.BodySecondary}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Style="{StaticResource Btn.Primary}" Click="InstallOllama_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;"
                                           FontFamily="{StaticResource Font.Icons}"
                                           FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Install Ollama"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Secondary}" Margin="10,0,0,0" Click="RetryEngine_Click">
                            <TextBlock Text="Retry" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    <Button Style="{StaticResource Btn.Link}"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0"
                            Click="ChangeEndpoint_Click">
                        <TextBlock Text="Using a remote or custom endpoint?" TextDecorations="Underline"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- composer -->

        <StackPanel Grid.Row="2" Margin="24,8,24,18">
            <Border Background="{DynamicResource Brush.Bg.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Input"
                             Grid.Column="0"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="6,6,4,6"
                             FontSize="13.5"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             MaxHeight="180"
                             Tag="Message Casium — Enter to send, Shift+Enter for a new line"
                             KeyDown="Input_KeyDown"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                VerticalAlignment="Bottom"
                                Margin="6,0,0,0">
                        <Button x:Name="SendButton"
                                Style="{StaticResource Btn.Send}"
                                Content="&#xE724;"
                                FontFamily="{StaticResource Font.Icons}"
                                Click="Send_Click"/>
                        <Button x:Name="StopButton"
                                Style="{StaticResource Btn.Stop}"
                                Content="&#xE71A;"
                                FontFamily="{StaticResource Font.Icons}"
                                Click="Stop_Click"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Margin="6,7,6,0">
                <TextBlock x:Name="FooterHint"
                           Style="{StaticResource Txt.Muted}"
                           Text="Enter to send · Shift+Enter for a new line"/>
                <TextBlock x:Name="FooterStats"
                           Style="{StaticResource Txt.Muted}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
