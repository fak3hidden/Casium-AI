<UserControl x:Class="Casium.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Casium.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,18" MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource Txt.H1}"/>
            <TextBlock Text="Engine, chat defaults, appearance and this machine's hardware"
                       Style="{StaticResource Txt.BodySecondary}" Margin="0,5,0,20"/>

            <!-- ============================== engine ============================== -->

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Inference engine" Style="{StaticResource Txt.H2}"/>
                        <controls:Pill x:Name="EnginePill" Text="offline" Kind="Danger"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Casium drives local models through an Ollama-compatible server. It auto-detects the default install; point it elsewhere if you run a custom host."
                               Style="{StaticResource Txt.BodySecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EndpointBox" Tag="http://127.0.0.1:11434"
                                 VerticalContentAlignment="Center"
                                 KeyDown="EndpointBox_KeyDown"/>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Margin="10,0,0,0"
                                Click="ApplyEndpoint_Click">
                            <TextBlock Text="Connect" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <TextBlock Text="Start the engine automatically if it isn't running"
                                   Style="{StaticResource Txt.BodySecondary}" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  x:Name="AutoStartSwitch" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                    </Grid>

                    <Separator Margin="0,16,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Link}" Click="InstallOllama_Click">
                            <TextBlock Text="Get Ollama (free) ↗" TextDecorations="Underline"/>
                        </Button>
                        <TextBlock Text="·" Style="{StaticResource Txt.Muted}" Margin="12,3,12,0"/>
                        <Button Style="{StaticResource Btn.Link}" Click="EngineDocs_Click">
                            <TextBlock Text="Ollama docs ↗" TextDecorations="Underline"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================== chat defaults ============================== -->

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Chat defaults" Style="{StaticResource Txt.H2}"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Default model" Style="{StaticResource Txt.BodySecondary}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="DefaultModelCombo" Grid.Column="1" DisplayMemberPath="Name"
                                  SelectionChanged="DefaultModel_Changed"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Default system prompt" Style="{StaticResource Txt.BodySecondary}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="DefaultPromptCombo" Grid.Column="1" DisplayMemberPath="Name"
                                  SelectionChanged="DefaultPrompt_Changed"/>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Temperature" Style="{StaticResource Txt.BodySecondary}"/>
                            <TextBlock x:Name="TemperatureValue" Text="0.70" Style="{StaticResource Txt.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Slider x:Name="TemperatureSlider" Grid.Column="1" VerticalAlignment="Center"
                                Minimum="0" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="Temperature_Changed"/>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Context window" Style="{StaticResource Txt.BodySecondary}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ContextCombo" Grid.Column="1" SelectionChanged="Context_Changed">
                            <ComboBoxItem Content="2k (2,048)" Tag="2048"/>
                            <ComboBoxItem Content="4k (4,096)" Tag="4096"/>
                            <ComboBoxItem Content="8k (8,192)" Tag="8192"/>
                            <ComboBoxItem Content="16k (16,384)" Tag="16384"/>
                            <ComboBoxItem Content="32k (32,768)" Tag="32768"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MCP tools in chat" Style="{StaticResource Txt.BodySecondary}"/>
                            <TextBlock Text="Let the model call your connected MCP servers"
                                       Style="{StaticResource Txt.Muted}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="ToolsSwitch" Style="{StaticResource Switch}" Grid.Column="1"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="Tools_Changed" Unchecked="Tools_Changed"/>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max tool rounds per message" Style="{StaticResource Txt.BodySecondary}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ToolLoopCombo" Grid.Column="1" SelectionChanged="ToolLoop_Changed">
                            <ComboBoxItem Content="2" Tag="2"/>
                            <ComboBoxItem Content="4" Tag="4"/>
                            <ComboBoxItem Content="6" Tag="6"/>
                            <ComboBoxItem Content="8" Tag="8"/>
                            <ComboBoxItem Content="10" Tag="10"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================== appearance ============================== -->

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource Txt.H2}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Theme" Style="{StaticResource Txt.BodySecondary}" VerticalAlignment="Center" MinWidth="80"/>
                        <RadioButton x:Name="ThemeMidnight" Style="{StaticResource Chip}" GroupName="Theme"
                                     Content="Midnight" Margin="0,0,8,0" Checked="Theme_Changed"/>
                        <RadioButton x:Name="ThemeDaylight" Style="{StaticResource Chip}" GroupName="Theme"
                                     Content="Daylight" Checked="Theme_Changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,2">
                        <TextBlock Text="Accent" Style="{StaticResource Txt.BodySecondary}" VerticalAlignment="Center" MinWidth="80"/>
                        <Button x:Name="AccentViolet" Style="{StaticResource Btn.Ghost}" Padding="4" Margin="0,0,6,0"
                                Click="Accent_Click" ToolTip="Violet">
                            <Ellipse Width="22" Height="22" Fill="#7C6DF2"/>
                        </Button>
                        <Button x:Name="AccentBlue" Style="{StaticResource Btn.Ghost}" Padding="4" Margin="0,0,6,0"
                                Click="Accent_Click" ToolTip="Blue">
                            <Ellipse Width="22" Height="22" Fill="#3E8BFF"/>
                        </Button>
                        <Button x:Name="AccentTeal" Style="{StaticResource Btn.Ghost}" Padding="4" Margin="0,0,6,0"
                                Click="Accent_Click" ToolTip="Teal">
                            <Ellipse Width="22" Height="22" Fill="#14B8A6"/>
                        </Button>
                        <Button x:Name="AccentRose" Style="{StaticResource Btn.Ghost}" Padding="4" Margin="0,0,6,0"
                                Click="Accent_Click" ToolTip="Rose">
                            <Ellipse Width="22" Height="22" Fill="#E85C8A"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================== hardware ============================== -->

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="This machine" Style="{StaticResource Txt.H2}"/>
                        <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Right" Click="CopyReport_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Font.Icons}"
                                           FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy report" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="HardwareRows" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <!-- ============================== about / data ============================== -->

            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="About Casium" Style="{StaticResource Txt.H2}"/>
                    <TextBlock Text="Casium 1.0 — a local AI studio built with WPF (.NET 8). Chat, model management and MCP tool-calling with zero telemetry: every request stays between this app, the engine and your MCP servers."
                               Style="{StaticResource Txt.BodySecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource Btn.Link}" Click="McpDocs_Click">
                            <TextBlock Text="Model Context Protocol ↗" TextDecorations="Underline"/>
                        </Button>
                        <TextBlock Text="·" Style="{StaticResource Txt.Muted}" Margin="12,3,12,0"/>
                        <Button Style="{StaticResource Btn.Link}" Click="OllamaLib_Click">
                            <TextBlock Text="Ollama model library ↗" TextDecorations="Underline"/>
                        </Button>
                    </StackPanel>

                    <Separator Margin="0,16,0,14"/>
                    <TextBlock Text="Data" Style="{StaticResource Txt.H3}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource Btn.Secondary}" Click="OpenDataFolder_Click">
                            <TextBlock Text="Open data folder" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource Btn.Danger}" Margin="10,0,0,0" Click="ResetSettings_Click">
                            <TextBlock Text="Reset all settings" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="DataFolderText" Style="{StaticResource Txt.Muted}" Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
