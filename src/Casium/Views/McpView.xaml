<UserControl x:Class="Casium.Views.McpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Casium.Controls">

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Connections" Style="{StaticResource Txt.H1}"/>
                <TextBlock Text="MCP servers give models real capabilities — your GitHub, project folders, search and more"
                           Style="{StaticResource Txt.BodySecondary}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Secondary}" Click="ExportConfig_Click" ToolTip="Copy the config file">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Export" VerticalAlignment="Center" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn.Primary}" Margin="10,0,0,0" Click="AddServer_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Add server" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel Margin="0,0,10,0">

                <!-- servers -->
                <ItemsControl x:Name="ServerList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,13">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8"
                                                     Fill="{Binding StatusBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,11,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource Txt.H3}"/>
                                                    <controls:Pill Text="{Binding StatusText}"
                                                                   Kind="{Binding StatusKind}"
                                                                   Margin="12,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    <controls:Pill Text="{Binding ToolsText}"
                                                                   Kind="Info"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Command}"
                                                           FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                                           Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ErrorText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Brush.Danger}"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="460"
                                                           HorizontalAlignment="Left"
                                                           Visibility="{Binding HasError, Converter={StaticResource Conv.Bool}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                                    HorizontalAlignment="Right">
                                            <Button Style="{StaticResource Btn.Secondary}"
                                                    Click="ConnectServer_Click"
                                                    IsEnabled="{Binding CanConnect}"
                                                    ToolTip="Start this server and list its tools">
                                                <TextBlock Text="Connect" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Style="{StaticResource Btn.Icon}" Margin="4,0,0,0"
                                                    FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                                    Content="&#xE70F;"
                                                    ToolTip="Edit"
                                                    Click="EditServer_Click"/>
                                            <Button Style="{StaticResource Btn.Icon}" Margin="2,0,0,0"
                                                    FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                                    Content="&#xE74D;"
                                                    ToolTip="Delete"
                                                    Click="DeleteServer_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Expander Header="Tools" FontSize="12" Margin="0,10,0,0"
                                              IsExpanded="False">
                                        <ItemsControl ItemsSource="{Binding Tools}"
                                                      Margin="0,4,0,2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,5,0,5">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontFamily="{StaticResource Font.Mono}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource Txt.Muted}"
                                                                   FontSize="11.5"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <Grid Margin="0,10,0,0">
                                        <TextBlock Text="Enabled in chats"
                                                   Style="{StaticResource Txt.Caption}"
                                                   VerticalAlignment="Center"/>
                                        <CheckBox Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right"
                                                  IsChecked="{Binding Enabled}"
                                                  Checked="Enabled_Changed"
                                                  Unchecked="Enabled_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- empty state -->
                <Border x:Name="EmptyState" Style="{StaticResource Card.Sunken}" Padding="22" Margin="0,4,0,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="No servers yet" Style="{StaticResource Txt.H3}"/>
                        <TextBlock Text="Add one from a preset below — GitHub and project folders are the most useful first picks."
                                   Style="{StaticResource Txt.BodySecondary}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- presets -->
                <TextBlock Text="Popular presets" Style="{StaticResource Txt.H2}" Margin="0,10,0,10"/>
                <ItemsControl x:Name="PresetList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Btn.Secondary}"
                                    Margin="0,0,10,10"
                                    Padding="14,10"
                                    MinWidth="230"
                                    HorizontalContentAlignment="Left"
                                    Click="Preset_Click"
                                    ToolTip="{Binding Hint}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}"
                                                   FontFamily="{StaticResource Font.Icons}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Hint}"
                                               Style="{StaticResource Txt.Muted}"
                                               FontSize="10.5"
                                               Margin="24,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- note -->
                <Border Style="{StaticResource Card.Sunken}" Padding="14" Margin="0,2,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="13"
                                   Foreground="{DynamicResource Brush.Info}"
                                   VerticalAlignment="Top"
                                   Margin="0,1,10,0"/>
                        <TextBlock Style="{StaticResource Txt.BodySecondary}" TextWrapping="Wrap">
                            <Run Text="MCP servers run locally as child processes — Casium talks to them over stdio, nothing goes through any cloud. Most presets need "/>
                            <Run Text="Node.js (npx)" FontWeight="SemiBold"/>
                            <Run Text=" installed; the official GitHub server needs Docker. Config lives in "/>
                            <Run x:Name="ConfigPathRun" Text="…"/>
                            <Run Text=" and stays compatible with Claude Desktop."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
