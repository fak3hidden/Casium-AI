<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent "Blue". -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#3E8BFF"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#5599FF"/>
    <SolidColorBrush x:Key="Brush.Accent.Press" Color="#2F7AE8"/>
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#2E3E8BFF"/>
    <SolidColorBrush x:Key="Brush.Accent.Softer" Color="#1A3E8BFF"/>
    <SolidColorBrush x:Key="Brush.Accent.Border" Color="#523E8BFF"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Brush.UserBubble.Bg" Color="#213E8BFF"/>
    <SolidColorBrush x:Key="Brush.UserBubble.Border" Color="#403E8BFF"/>

</ResourceDictionary>
