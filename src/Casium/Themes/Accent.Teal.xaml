<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent "Teal". -->

    <SolidColorBrush x:Key="Brush.Accent" Color="#14B8A6"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#22C9B6"/>
    <SolidColorBrush x:Key="Brush.Accent.Press" Color="#0FA292"/>
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#2E14B8A6"/>
    <SolidColorBrush x:Key="Brush.Accent.Softer" Color="#1A14B8A6"/>
    <SolidColorBrush x:Key="Brush.Accent.Border" Color="#5214B8A6"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Brush.UserBubble.Bg" Color="#2114B8A6"/>
    <SolidColorBrush x:Key="Brush.UserBubble.Border" Color="#4014B8A6"/>

</ResourceDictionary>
