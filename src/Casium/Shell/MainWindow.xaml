<Window x:Class="Casium.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Casium"
        Width="1380" Height="860" MinWidth="1150" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg.Base}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Primary}"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="/Assets/icon.ico"
        PreviewKeyDown="OnPreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Window.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="242"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================== title bar ============================== -->

            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource Brush.Bg.Base}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png"
                               Width="20" Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="Casium"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Margin="10,1,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xB7;"
                                   FontSize="13"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   Margin="10,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PageTitle" Text="Chat"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="EngineStatus" Click="EngineStatus_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource Btn.Ghost}" Padding="10,5" Margin="0,0,6,0"
                                Cursor="Hand" ToolTip="Engine status — click to open settings">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="EngineDot" Width="7" Height="7"
                                         Fill="{DynamicResource Brush.Text.Muted}"
                                         Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="EngineText" Text="Engine offline"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Content="&#xE921;" Style="{StaticResource Btn.Window}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="Minimize_Click" ToolTip="Minimize"/>
                        <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource Btn.Window}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="Maximize_Click" ToolTip="Maximize"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource Btn.WindowClose}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="Close_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================== sidebar ============================== -->

            <Border Grid.Row="1" Grid.Column="0"
                    Background="{DynamicResource Brush.Bg.Sidebar}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="0,14,0,14">
                    <Border DockPanel.Dock="Bottom" Margin="14,0">
                        <StackPanel>
                            <Separator Margin="0,0,0,10"/>
                            <Button Click="EngineStatus_Click" Style="{StaticResource Btn.Ghost}"
                                    HorizontalContentAlignment="Left" Padding="8,8">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="FooterDot" Width="7" Height="7"
                                             Fill="{DynamicResource Brush.Text.Muted}"
                                             Margin="0,2,10,0" VerticalAlignment="Top"/>
                                    <StackPanel>
                                        <TextBlock Text="LOCAL ENGINE" FontSize="10"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock x:Name="FooterEngineText" Text="Not running"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Casium 1.0 — everything stays on this machine"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       Margin="10,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="WORKSPACE" FontSize="10"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   Margin="20,4,0,8"/>
                        <RadioButton x:Name="NavChat" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Content="Chat" Tag="&#xE8BD;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavBrowse" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Content="Browse models" Tag="&#xE719;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavModels" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Content="Local models" Tag="&#xE8F1;" Checked="Nav_Checked"/>

                        <TextBlock Text="AI BEHAVIOR &amp; TOOLS" FontSize="10"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   Margin="20,18,0,8"/>
                        <RadioButton x:Name="NavPrompts" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Content="Prompts" Tag="&#xE70F;" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavConnections" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Content="Connections" Tag="&#xE756;" Checked="Nav_Checked"/>

                        <TextBlock Text="APP" FontSize="10"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   Margin="20,18,0,8"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Content="Settings" Tag="&#xE713;" Checked="Nav_Checked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============================== content ============================== -->

            <ContentControl x:Name="Host" Grid.Row="1" Grid.Column="1" Focusable="False"/>

            <!-- toasts overlay -->
            <Grid x:Name="ToastLayer"
                  Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                  VerticalAlignment="Bottom" HorizontalAlignment="Center"
                  Margin="0,0,0,26"
                  IsHitTestVisible="False" Panel.ZIndex="100"/>
        </Grid>
    </Border>
</Window>
